{
  "name": "welcomer",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev dev:gateway dev:rest dev:bot",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "^2.11.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^26"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "4.18.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
