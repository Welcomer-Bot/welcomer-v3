{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "RABBITMQ_URL",
    "DISCORD_TOKEN",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "REST_PROXY_URL",
    "REST_PROXY_SECRET",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "ADMIN_DISCORD_IDS",
    "SUPPORT_SERVER_URL",
    "DASHBOARD_URL",
    "LOG_LEVEL",
    "DISCORD_API_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "^db:generate", "db:generate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^db:generate", "db:generate"]
    },
    "test": {
      "dependsOn": ["^db:generate"]
    },
    "e2e": {
      "dependsOn": ["build"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "dev:gateway": { "cache": false, "persistent": true },
    "dev:rest": { "cache": false, "persistent": true },
    "dev:bot": { "cache": false, "persistent": true },
    "db:generate": { "cache": false },
    "db:migrate": { "cache": false },
    "db:deploy": { "cache": false },
    "db:seed": { "cache": false, "dependsOn": ["db:generate"] }
  }
}
