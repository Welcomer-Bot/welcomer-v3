{
  "name": "bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:gateway": "node --watch --env-file-if-exists=.env src/gateway/index.ts",
    "dev:rest": "node --watch --env-file-if-exists=.env src/rest/index.ts",
    "dev:bot": "node --watch --env-file-if-exists=.env src/bot/index.ts",
    "register-commands": "node --env-file-if-exists=.env src/bot/register-commands.ts",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordeno/bot": "22.0.0-beta.2",
    "@fastify/multipart": "10.1.9",
    "@repo/database": "workspace:*",
    "@repo/domain": "workspace:*",
    "amqplib": "2.4.0",
    "fastify": "5.12.8",
    "pino": "10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
